# ===========================
# PetsApp — .gitignore
# ===========================

# ---- Java / Maven ----
target/
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*
.mvn/wrapper/maven-wrapper.jar

# ---- Spring Boot ----
backend/src/main/resources/application-prod.yml
backend/src/main/resources/application-secrets.yml

# ---- Node / React Native ----
node_modules/
mobile/.expo/
mobile/dist/
mobile/.cache/
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Expo ----
mobile/.expo-shared/
mobile/android/
mobile/ios/
*.orig.*
web-build/

# ---- Environment / Secrets ----
.env
.env.local
.env.*.local
*.env
**/.env

# ---- Docker volumes (local) ----
.docker/
docker-data/
postgres-data/
redis-data/

# ---- IDE ----
.idea/
*.iml
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---- Logs ----
logs/
*.log

# ---- Test reports ----
backend/target/surefire-reports/
backend/target/failsafe-reports/
