# ===========================
# PetsApp — Zmienne środowiskowe DEV
# ===========================
# Skopiuj ten plik: cp .env.example .env
# Plik .env jest w .gitignore — NIGDY nie commituj .env z prawdziwymi danymi!

# ---- PostgreSQL ----
POSTGRES_DB=petsapp_dev
POSTGRES_USER=petsapp
POSTGRES_PASSWORD=change_me_dev_only

# ---- JWT ----
JWT_SECRET=change_me_min_32_chars_required

# ---- Redis ----
# Brak hasła w dev. Na prod ustaw REDIS_PASSWORD.

# ---- MinIO (lokalne S3 dev) ----
MINIO_ROOT_USER=petsapp_minio
MINIO_ROOT_PASSWORD=change_me_dev_only
